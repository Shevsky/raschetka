{
  "name": "raschetka",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "prisma:generate": "prisma generate --no-hints",
    "prisma:copy-assets": "sh -lc 'find src/persistence/generated/client -type f ! -name \"*.ts\" -exec sh -c '\\''t=\"dist/app/persistence/generated/client/${1#src/persistence/generated/client/}\"; mkdir -p \"$(dirname \"$t\")\"; cp \"$1\" \"$t\"'\\'' _ {} \\;'",
    "prisma:migrate": "prisma migrate dev --skip-seed",
    "prisma:force-reset": "prisma db push --force-reset --accept-data-loss && prisma db seed",
    "app:build": "tsc --noCheck --outDir dist/app && tsc-alias --dir dist/app --resolve-full-paths true && rimraf dist/app/web",
    "app:dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false -r dotenv-flow/config src/app/index.ts",
    "web:build": "vite build --logLevel error",
    "web:dev": "node -r dotenv-flow/config node_modules/vite/bin/vite.js",
    "lint": "eslint . --ext .ts,.tsx --cache --cache-location .eslintcache",
    "lint:clear": "rm .eslintcache",
    "lint:watch": "bash -lc 'trap \"eslint_d stop\" INT TERM EXIT; eslint_d restart; chokidar \"src/**/*.{ts,tsx}\" -c \"eslint_d . --ext .ts,.tsx --cache --cache-location .eslintcache\" --debounce 200 --initial --silent'",
    "build": "rimraf dist && npm run prisma:generate && concurrently \"npm run app:build\" \"npm run web:build\" --prefix none && npm run prisma:copy-assets",
    "dev": "concurrently \"npm run lint:watch\" \"npm run app:dev\" \"npm run web:dev\" --prefix none",
    "start": "NODE_ENV=production npx prisma migrate deploy && node app/index.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "./prisma/schema",
    "seed": "tsx ./prisma/seed/index.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-error-on-unmatched-pattern --no-warn-ignored --max-warnings 0 ."
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/passport": "3.0.2",
    "@fastify/session": "11.1.0",
    "@fastify/static": "8.2.0",
    "@fastify/websocket": "11.0.2",
    "@grammyjs/hydrate": "1.4.1",
    "@prisma/client": "6.7.0",
    "@trpc/server": "11.1.2",
    "core-js": "3.44.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "decorio": "1.2.1",
    "dedent": "1.5.3",
    "dockerode": "4.0.7",
    "emoji-regex": "10.4.0",
    "fastify": "5.3.2",
    "fetch-socks": "1.3.2",
    "grammy": "1.36.1",
    "lvovich": "2.0.2",
    "memoize-one": "6.0.0",
    "node-cron": "4.2.1",
    "prisma": "6.7.0",
    "rxjs": "7.8.2",
    "socks-proxy-agent": "9.0.0",
    "superjson": "2.2.2",
    "ts-pattern": "5.7.0",
    "undici": "7.24.5",
    "uuid": "11.1.0",
    "zod": "3.24.4",
    "zxing-wasm": "2.1.1"
  },
  "devDependencies": {
    "@emotion/css": "11.13.5",
    "@eslint/js": "9.26.0",
    "@mantine/core": "8.0.2",
    "@stylistic/eslint-plugin": "4.2.0",
    "@tabler/icons-react": "3.17.0",
    "@tma.js/sdk": "3.1.6",
    "@total-typescript/ts-reset": "0.6.1",
    "@trpc/client": "11.1.2",
    "@types/dockerode": "3.3.42",
    "@types/express": "5.0.1",
    "@types/node": "20.10.0",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react-swc": "3.9.0",
    "chokidar-cli": "3.0.0",
    "concurrently": "9.1.2",
    "cross-env": "10.1.0",
    "dotenv-flow": "4.1.0",
    "eruda": "3.0.1",
    "eslint": "9.26.0",
    "eslint_d": "14.3.0",
    "eslint-config-prettier": "10.1.3",
    "eslint-import-resolver-typescript": "4.3.5",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.4.0",
    "eslint-plugin-unicorn": "59.0.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "mobx": "6.13.7",
    "mobx-react-lite": "4.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-sort-imports": "1.8.8",
    "prisma-generator-typescript-interfaces": "2.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "6.23.0",
    "rimraf": "6.0.1",
    "tsc-alias": "1.8.15",
    "tslib": "2.8.1",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite": "6.3.4",
    "vite-plugin-checker": "0.9.3",
    "vite-plugin-mkcert": "1.17.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.0.5"
  }
}
